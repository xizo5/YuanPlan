[Unit]
Description=Publish tested YuanPlan main commits
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=oneshot
User=root
UMask=0077
ExecStart=/usr/bin/python3 /usr/local/lib/yuanplan-release/publisher.py --config /etc/yuanplan-release/config.json
TimeoutStartSec=75min
TimeoutStopSec=30s
KillMode=control-group
PrivateTmp=true
ProtectSystem=full
NoNewPrivileges=true
StandardOutput=journal
StandardError=journal
